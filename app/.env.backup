# Left here on purpose. This is the incident.
#
# A key created months ago to add and remove custom domains. Nobody scoped it,
# so it carries every permission the platform has. In hardened mode the same
# file holds a key scoped to what it was actually made for.
#
# ./rogue mode vulnerable|hardened rewrites this file.

PLATFORM_REGION=us-west-2
PLATFORM_ACCESS_KEY_ID=PLACEHOLDER
PLATFORM_SECRET_ACCESS_KEY=PLACEHOLDER
